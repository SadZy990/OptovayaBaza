@model IEnumerable<OptovayaBaza.Models.Transaction>
@{
    ViewBag.Title = "Все операции";
}

<h2>Все операции (отгрузки и возвраты)</h2>

<!-- Filter датка, не забыть -->
<form method="get" class="form-inline" style="margin-bottom: 20px">
    <div class="form-group" style="margin-right: 10px">
        <label>С даты:</label>
        <input type="date" name="from" class="form-control" value="@ViewBag.From" />
    </div>
    <div class="form-group" style="margin-right: 10px">
        <label>По дату:</label>
        <input type="date" name="to" class="form-control" value="@ViewBag.To" />
    </div>
    <button type="submit" class="btn btn-primary">Фильтровать</button>
    <a href="@Url.Action("AllTransactions")" class="btn btn-default">Сбросить</a>
    <a href="@Url.Action("Index")" class="btn btn-default" style="margin-left: 10px">Назад в панель</a>
</form>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Дата и время</th>
            <th>Тип операции</th>
            <th>Материал</th>
            <th>Количество</th>
            <th>Ед. изм.</th>
            <th>Оптовик</th>
            <th>Администратор</th>
            <th>Комментарий</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.DateTime.ToString("dd.MM.yyyy HH:mm:ss")</td>
                <td>
                    @if (item.Type == "Shipment")
                    {
                        <span class="label label-danger" style="background-color: #d9534f; padding: 5px 10px; border-radius: 3px;">Отгрузка</span>
                    }
                    else
                    {
                        <span class="label label-success" style="background-color: #5cb85c; padding: 5px 10px; border-radius: 3px;">Принятие/Возврат</span>
                    }
                </td>
                <td>@(item.Material?.Name ?? "-")</td>
                <td>@item.Quantity.ToString("N2")</td>
                <td>@(item.Material?.Unit ?? "-")</td>
                <td>
                    @if (item.Wholesaler != null)
                    {
                        @item.Wholesaler.OrganizationName
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </td>
                <td>
                    @if (item.Admin != null)
                    {
                        @item.Admin.Login
                    }
                    else if (item.Wholesaler != null && item.Type == "Receipt")
                    {
                        <span class="text-muted">(возврат от оптовика)</span>
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </td>
                <td>@item.Comment</td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Нет операций за выбранный период
    </div>
}