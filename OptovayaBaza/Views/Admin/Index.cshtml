@{
    ViewBag.Title = "Панель администратора";
}

<div class="jumbotron" style="background-color: #2c3e50; color: white; padding: 30px; border-radius: 10px;">
    <h2>Панель администратора</h2>
    <p>Добро пожаловать!</p>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="panel panel-primary">
            <div class="panel-heading">
                <h3 class="panel-title">Управление материалами</h3>
            </div>
            <div class="panel-body">
                <p>Добавление, редактирование и удаление материалов</p>
                <a href="@Url.Action("Index", "Materials")" class="btn btn-primary">Перейти →</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="panel panel-success">
            <div class="panel-heading">
                <h3 class="panel-title">Управление оптовиками</h3>
            </div>
            <div class="panel-body">
                <p>Добавление, редактирование и удаление оптовиков</p>
                <a href="@Url.Action("Index", "WholesalersManage")" class="btn btn-success">Перейти →</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="panel panel-info">
            <div class="panel-heading">
                <h3 class="panel-title">Все операции</h3>
            </div>
            <div class="panel-body">
                <p>Просмотр всех операций отгрузки и возврата</p>
                <a href="@Url.Action("AllTransactions", "Admin")" class="btn btn-info">Перейти →</a>
            </div>
        </div>
    </div>
</div>